{
  "permissions": {
    "allow": [
      "Bash(gh project view *)",
      "Bash(gh project item-list *)",
      "Bash(gh project item-edit *)",
      "Bash(gh project item-create *)",
      "Bash(gh project field-list *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue create *)",
      "Bash(gh label list *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git worktree *)"
    ]
  },
  "enabledMcpjsonServers": ["svelte"],
  "extraKnownMarketplaces": {
    "gauransh": {
      "source": { "source": "github", "repo": "GauranshMathur/codex-headless-skill" }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "codex-headless@gauransh": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; b=$(basename \"$f\"); case \"$b\" in .env.example) exit 0;; .env|.env.*|*.pem|*.key) echo \"Blocked: $b holds secrets. Edit .env.example (the template) instead; real values are applied locally, then reverted.\" >&2; exit 2;; esac; exit 0; }"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "jq -r '.tool_input.file_path // empty' | { IFS= read -r f; [ -f \"$f\" ] || exit 0; cd \"$(dirname \"$f\")\" && bunx --no-install biome format --write --no-errors-on-unmatched --files-ignore-unknown=true \"$f\" >/dev/null 2>&1; exit 0; }"
          }
        ]
      }
    ]
  }
}
