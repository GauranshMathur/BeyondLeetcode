{
	"name": "beyondleetcode",
	"private": true,
	"version": "1.10.7",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; prisma generate",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:bun": "bun src/lib/server/runner/engine.bun-check.ts",
		"test:sandbox": "vitest run --config vitest.sandbox.config.ts",
		"runner": "bun src/lib/server/runner/main.ts",
		"test:e2e": "playwright test",
		"test:smoke": "playwright test --config playwright.smoke.config.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.6.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@codemirror/lang-go": "^6.0.1",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@lezer/highlight": "^1.2.5",
		"@libsql/client": "^0.18.0",
		"@prisma/adapter-libsql": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"better-auth": "^1.7.12",
		"codemirror": "^6.0.2",
		"marked": "^18.1.1",
		"prisma": "^7.10.1",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
