generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
}

// A person working through the Topic Map, in either mode (CONTEXT.md).
model Learner {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

// A Learner has reached the end of a Chapter (CONTEXT.md: Read). Keyed by the stable content id.
model ChapterRead {
  learnerId String
  chapterId String
  readAt    DateTime @default(now())

  @@id([learnerId, chapterId])
}
