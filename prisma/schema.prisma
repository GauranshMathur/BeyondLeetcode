generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
}

// A person working through the Topic Map, in either mode (CONTEXT.md).
model Learner {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

// A Learner has reached the end of a Chapter (CONTEXT.md: Read). Keyed by the stable content id.
model ChapterRead {
  learnerId String
  chapterId String
  readAt    DateTime @default(now())

  @@id([learnerId, chapterId])
}

// One Learner's code for one Problem in one Topic's Build in one Language. Stored when first
// saved, so later upstream content edits never change it (docs/module-map.md).
model BuildStep {
  learnerId String
  topicId   String
  language  String
  problemId String
  /// Path (relative to the Build root) to file content.
  files     Json
  /// Starts at 1; every save must name the revision it was based on.
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@id([learnerId, topicId, language, problemId])
}

// The Language a Learner is building one Topic in. No row means Python. Switching changes only
// this row: every Language keeps its own BuildSteps.
model TopicLanguage {
  learnerId String
  topicId   String
  language  String

  @@id([learnerId, topicId])
}

// How many of a Problem's Hints a Learner has revealed (CONTEXT.md: Hint). Hints reveal in number
// order, so one number is the whole state. No row means none.
model HintsRevealed {
  learnerId String
  problemId String
  count     Int

  @@id([learnerId, problemId])
}

// One Submit of a Problem (CONTEXT.md: Submission). A Problem is Solved once any of its
// Submissions is Accepted, Attempted while it has some but none Accepted.
model Submission {
  id               String   @id @default(cuid())
  learnerId        String
  problemId        String
  topicId          String
  language         String
  /// Snapshot of the Build that was submitted: path to file content.
  files            Json
  /// Accepted, Wrong Answer, Runtime Error, Time Limit Exceeded or Compile Error.
  verdict          String
  /// The Problem whose Test failed first; null when Accepted or on a Compile Error.
  failingProblemId String?
  createdAt        DateTime @default(now())

  @@index([learnerId, createdAt])
}

// The Instance's one row (CONTEXT.md: Instance). No row means not set up; the fixed id makes
// creating it the claim. mode is `local` or `multi`, registrationMode `open` or `invite`.
model Instance {
  id               String @id @default("instance")
  mode             String
  registrationMode String @default("invite")
}

// An Account, Better Auth's `user` (src/lib/server/identity/auth.ts). Not progress: learnerId only
// links an Account to its Learner, who owns all progress. The models below this one are Better
// Auth's own tables, hand-written to match its schema; the admin plugin adds role, banned,
// banReason, banExpires and Session.impersonatedBy.
model User {
  id                 String    @id
  name               String
  email              String    @unique
  emailVerified      Boolean   @default(false)
  image              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  role               String?
  banned             Boolean?  @default(false)
  banReason          String?
  banExpires         DateTime?
  learnerId          String    @unique
  mustChangePassword Boolean   @default(false)
  sessions           Session[]
  accounts           Account[]
  invites            Invite[]
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

/// An invite link for one new account. Only the SHA-256 of the token is stored; the link is shown once.
model Invite {
  id              String    @id
  tokenHash       String    @unique
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  usedAt          DateTime?
  createdByUserId String
  createdBy       User      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([createdByUserId])
}
