generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
}

// A person working through the Topic Map, in either mode (CONTEXT.md).
model Learner {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

// A Learner has reached the end of a Chapter (CONTEXT.md: Read). Keyed by the stable content id.
model ChapterRead {
  learnerId String
  chapterId String
  readAt    DateTime @default(now())

  @@id([learnerId, chapterId])
}

// One Learner's code for one Problem in one Topic's Build in one Language. Stored when first
// saved, so later upstream content edits never change it (docs/module-map.md).
model BuildStep {
  learnerId String
  topicId   String
  language  String
  problemId String
  /// Path (relative to the Build root) to file content.
  files     Json
  /// Starts at 1; every save must name the revision it was based on.
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@id([learnerId, topicId, language, problemId])
}

// One Submit of a Problem (CONTEXT.md: Submission). A Problem is Solved once any of its
// Submissions is Accepted, Attempted while it has some but none Accepted.
model Submission {
  id               String   @id @default(cuid())
  learnerId        String
  problemId        String
  topicId          String
  language         String
  /// Snapshot of the Build that was submitted: path to file content.
  files            Json
  /// Accepted, Wrong Answer, Runtime Error, Time Limit Exceeded or Compile Error.
  verdict          String
  /// The Problem whose Test failed first; null when Accepted or on a Compile Error.
  failingProblemId String?
  createdAt        DateTime @default(now())

  @@index([learnerId, createdAt])
}
