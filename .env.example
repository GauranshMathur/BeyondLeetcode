# SQLite file the Instance stores its data in; the Prisma CLI reads it through prisma.config.ts.
DATABASE_URL="file:./prisma/dev.db"

# Folder holding the content (content.json and topics/), read once at server start.
# In development, point it at the fixture: src/lib/server/content/fixture
CONTENT_DIR="src/lib/server/content/fixture"

# The Runner process (the `runner` role) listens here; every request needs the bearer token.
RUNNER_PORT="8787"
# At least 32 characters; the Runner refuses to start with a shorter one.
RUNNER_TOKEN="change-me-to-a-random-string-of-32-or-more-characters"
# Interface the Runner binds to (default 0.0.0.0).
RUNNER_HOST="0.0.0.0"
# Most runs in flight at once; more get 503 straight away (default: the machine's CPU count).
# RUNNER_MAX_CONCURRENT="4"
# Container engine socket, held by the Runner only.
DOCKER_SOCKET="/var/run/docker.sock"
