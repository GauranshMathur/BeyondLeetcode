# SQLite file the Instance stores its data in; the Prisma CLI reads it through prisma.config.ts.
DATABASE_URL="file:./prisma/dev.db"

# Folder holding the content (content.json and topics/), read once at server start.
# In development, point it at the fixture: src/lib/server/content/fixture
CONTENT_DIR="src/lib/server/content/fixture"

# Where the web server reaches the Runner (required at startup); RUNNER_TOKEN below is the bearer token it sends.
RUNNER_URL="http://localhost:8787"

# The Runner process (the `runner` role) listens here; every request needs the bearer token.
RUNNER_PORT="8787"
# At least 32 characters; the Runner refuses to start with a shorter one.
RUNNER_TOKEN="change-me-to-a-random-string-of-32-or-more-characters"
# Interface the Runner binds to (default 0.0.0.0).
RUNNER_HOST="0.0.0.0"
# Most runs in flight at once; more get 503 straight away (default: the machine's CPU count).
# RUNNER_MAX_CONCURRENT="4"
# Container engine socket, held by the Runner only.
DOCKER_SOCKET="/var/run/docker.sock"

# Public URL of the Instance; SvelteKit's CSRF check needs it; behind a reverse proxy use PROTOCOL_HEADER/HOST_HEADER instead
# (Multi-user still needs this fixed URL: it sets the sign-in cookie's Secure flag).
ORIGIN="http://localhost:5173"

# Behind a reverse proxy the client address is the proxy's, so every sign-in would share one rate-limit bucket.
# Name the header your proxy sets with the real client address, and how many proxies append to it
# (SvelteKit's adapter-node reads both; leave them unset when clients connect straight to the app).
# ADDRESS_HEADER="X-Forwarded-For"
# XFF_DEPTH="1"

# Multi-user only. Signs sessions; 48+ random characters, e.g. `openssl rand -hex 24`. Setup offers Multi-user only
# when this is set and ORIGIN above is a fixed URL (PROTOCOL_HEADER/HOST_HEADER alone are not enough);
# an Instance that is already Multi-user will not start without both.
BETTER_AUTH_SECRET="change-me-to-a-random-string-of-48-characters"
# GitHub OAuth app credentials for sign-in (optional).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Google OAuth client credentials for sign-in (optional).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
