# SQLite file the Instance stores its data in; the Prisma CLI reads it through prisma.config.ts.
DATABASE_URL="file:./prisma/dev.db"

# Folder holding the content (content.json and topics/), read once at server start.
# In development, point it at the fixture: src/lib/server/content/fixture
CONTENT_DIR="src/lib/server/content/fixture"
