# SQLite file the Instance stores its data in; the Prisma CLI reads it through prisma.config.ts.
DATABASE_URL="file:./prisma/dev.db"

# Folder holding the content (content.json and topics/), read once at server start.
# In development, point it at the fixture: src/lib/server/content/fixture
CONTENT_DIR="src/lib/server/content/fixture"

# Where the web server reaches the Runner (required at startup); RUNNER_TOKEN below is the bearer token it sends.
RUNNER_URL="http://localhost:8787"

# The Runner process (the `runner` role) listens here; every request needs the bearer token.
RUNNER_PORT="8787"
# At least 32 characters; the Runner refuses to start with a shorter one.
RUNNER_TOKEN="change-me-to-a-random-string-of-32-or-more-characters"
# Interface the Runner binds to (default 0.0.0.0).
RUNNER_HOST="0.0.0.0"
# Most runs in flight at once; more get 503 straight away (default: the machine's CPU count).
# RUNNER_MAX_CONCURRENT="4"
# Container engine socket, held by the Runner only.
DOCKER_SOCKET="/var/run/docker.sock"

# Public URL of the Instance; SvelteKit's CSRF check needs it, and Multi-user requires it: Setup does not offer
# Multi-user without it, and a Multi-user Instance will not start without it. PROTOCOL_HEADER/HOST_HEADER do not
# replace it. Local mode behind a reverse proxy can use them instead, with this line removed (an empty ORIGIN stops the server).
ORIGIN="http://localhost:5173"

# Behind a reverse proxy the client address is the proxy's, so every sign-in would share one rate-limit bucket.
# Name the header your proxy sets with the real client address, and how many trusted proxies sit in front of the app
# (SvelteKit's adapter-node reads both; leave them unset when clients connect straight to the app).
# Set them only if every request comes through the proxy: a client that reaches the app directly could forge the header.
# In Docker, publish the port as 127.0.0.1:${PORT}:3000 (a proxy on this machine) or keep it on the proxy's network only:
# the default binding is on every interface and gets past ufw.
# ADDRESS_HEADER="X-Forwarded-For"
# XFF_DEPTH="1"

# Multi-user only. Signs sessions; 48+ random characters, e.g. `openssl rand -hex 24` (32 is the least; this
# example value is refused). Setup offers Multi-user only when this is set and ORIGIN above is a fixed URL
# (PROTOCOL_HEADER/HOST_HEADER alone are not enough); an Instance that is already Multi-user will not start without both.
BETTER_AUTH_SECRET="change-me-to-a-random-string-of-48-characters"
# Never set these. Better Auth reads them from the environment on its own:
#   BETTER_AUTH_SECRETS replaces the session secret above, and BETTER_AUTH_TRUSTED_ORIGINS adds origins to the one
#   ORIGIN names. The app refuses to start while either is set.
#   BETTER_AUTH_URL, PUBLIC_BETTER_AUTH_URL and BASE_URL name another base URL (the app passes ORIGIN, so they have no
#   effect today), and BETTER_AUTH_TELEMETRY with BETTER_AUTH_TELEMETRY_ENDPOINT sends Better Auth's telemetry there.
# GitHub OAuth app credentials for sign-in (optional).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Google OAuth client credentials for sign-in (optional).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
